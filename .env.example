# Copy this file to .env and add your key privately. Restart the backend after changes.
OPENAI_API_KEY=your-key-here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:8010,http://127.0.0.1:8010
# Optional: DATA_DIR=/absolute/path/to/private/local/storage
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
